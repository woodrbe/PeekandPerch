# Birdfy Portal Credentials for Scraper Agent
BIRDFY_EMAIL=
BIRDFY_PASSWORD=

# Feeder Camera Device ID (found in my.birdfy.com URL: /devices/<DEVICE_ID>/events)
# Optional: if omitted, the scraper agent will automatically use the first active feeder
BIRDFY_DEVICE_ID=

# Scraper Browser Mode (true = headless in background, false = visible browser window for testing)
HEADLESS=true

# Cloudflare R2 Object Storage & D1 Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<BUCKET>.<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=peekandperch-media
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
